# Waveshare ESP32-P4-Pico / ESP32-P4NRW32X: dual RISC-V 360 MHz, 16 MB NOR.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM disabled entirely for this boot-proof image. All bench variants that
# matter (A/B/C/D, 16/32 voices, 48k) live in internal RAM; profile E reports
# unavailable instead of allocating.

# UART0 only. The USB-Serial-JTAG secondary is initialised inside
# bootloader_console_init(), the last thing before the banner prints -- a
# suspect for a silent pre-console hang, so it is off until we are booting.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_ROM_SERIAL_PORT_NUM=0

CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=2
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# CONFIG_HAL_WDT_USE_ROM_IMPL is not set
CONFIG_PARTITION_TABLE_OFFSET=0x9000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
